// Cloudflare veröffentlicht diese Seite bei jedem Push auf main (Workers Builds).
// Ausgeliefert wird der Ordner selbst – was nicht auf die Seite gehört, steht in
// .assetsignore. Erreichbar ist sie nur unter monatskasse.de, nicht unter workers.dev.
{
  "name": "monatskasse",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "."
  }
}
