// Cloudflare veröffentlicht diese Seite bei jedem Push auf main (Workers Builds):
// Build command `npm run build` schreibt sie nach out/, `npx wrangler deploy` lädt den
// Ordner hoch. Erreichbar ist sie nur unter monatskasse.de, nicht unter workers.dev.
{
  "name": "monatskasse",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    // Unbekannte Adressen bekommen die 404-Seite ihrer Sprache (/en/404.html, sonst /404.html).
    "not_found_handling": "404-page"
  }
}
